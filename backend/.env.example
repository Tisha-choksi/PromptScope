# Copy this file to .env and fill in your values.
#
# LOCAL DEV (running uvicorn directly on your machine):
#   Use localhost for DATABASE_URL and REDIS_URL (values below are already correct).
#
# DOCKER COMPOSE:
#   Override DATABASE_URL and REDIS_URL via the docker-compose.yml environment block
#   (already configured there) — you don't need to change them here for Docker.

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptscope
REDIS_URL=redis://localhost:6379/0

SECRET_KEY=change-me-in-production

# Add at least one LLM API key. Providers without a key are skipped automatically.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=...
PERPLEXITY_API_KEY=pplx-...
